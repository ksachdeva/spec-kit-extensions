{
    "$schema": "https://opencode.ai/config.json",
    "providers": {
        "host-ollama": {
            "package": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "settings": {
                "baseURL": "http://host.docker.internal:11434/v1"
            },
            "models": {
                "gemma4:12b-mlx": {
                    "name": "gemma4:12b-mlx"
                },
                "gemma4:31b-mlx": {
                    "name": "gemma4:31b-mlx"
                },
                "qwen3.8:27b-mlx": {
                    "name": "qwen3.8:27b-mlx"
                }
            }
        },
        "my-azure": {
            "package": "@ai-sdk/azure",
            "name": "My Azure",
            "settings": {
                "resourceName": "{env:AZURE_RESOURCE}",
                "apiKey": "{env:AZURE_OPENAI_API_KEY}"
            },
            "models": {
                "gpt-6-luna": {
                    "name": "azure-gpt-6-luna"
                },
                "gpt-6.1-sol": {
                    "name": "azure-gpt-6.1-sol"
                }
            }
        }
    },
    "plugins": []
}
